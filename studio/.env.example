# Micro-RAG Studio environment configuration (copy to `.env` for local overrides)
#
# By default, Studio runs as a standalone client-side playground with no backend
# or database required. Leave auth disabled locally unless testing federated OAuth.

# Set to "false" to disable sign-in UI locally (default when unset requires OAuth creds).
VITE_AUTH_ENABLED=false

# Grok live-preview OAuth client (server-only, optional).
# Required only when enabling federated sign-in on `*.grok-sandbox.com` previews.
# If `GROK_PREVIEW_CLIENT_SECRET` is unset, preview OAuth is disabled gracefully.
GROK_PREVIEW_CLIENT_ID=grok_preview
GROK_PREVIEW_CLIENT_SECRET=

# Deployed app OAuth / Better Auth / Postgres configuration (server-only, optional).
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=
# DATABASE_URL=
